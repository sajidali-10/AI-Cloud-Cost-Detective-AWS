APP_ENV=development

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME

# Application logical database
COST_DETECTIVE_DB=cost_detective
COST_DETECTIVE_DB_USER=cost_detective_user
COST_DETECTIVE_DB_PASSWORD=CHANGE_ME

# LiteLLM logical database
LITELLM_DB=litellm
LITELLM_DB_USER=litellm_user
LITELLM_DB_PASSWORD=CHANGE_ME

# --- LiteLLM Gateway ---
# Master key MUST start with sk-
LITELLM_MASTER_KEY=sk-CHANGE_ME
LITELLM_SALT_KEY=CHANGE_ME
LITELLM_HOST=litellm
LITELLM_PORT=4000

# --- Backend / FastAPI ---
APP_SECRET_KEY=CHANGE_ME

# --- CORS (env-driven, comma-separated; never use wildcard with credentials) ---
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# --- AWS region (no AWS credentials in Phase 0; used from Phase 1) ---
AWS_DEFAULT_REGION=us-east-1
