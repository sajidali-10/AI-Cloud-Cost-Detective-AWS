APP_ENV=development

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME

# Application logical database
COST_DETECTIVE_DB=cost_detective
COST_DETECTIVE_DB_USER=cost_detective_user
COST_DETECTIVE_DB_PASSWORD=CHANGE_ME

# LiteLLM logical database
LITELLM_DB=litellm
LITELLM_DB_USER=litellm_user
LITELLM_DB_PASSWORD=CHANGE_ME

# --- LiteLLM Gateway ---
# Master key MUST start with sk-
LITELLM_MASTER_KEY=sk-CHANGE_ME
LITELLM_SALT_KEY=CHANGE_ME
LITELLM_HOST=litellm
LITELLM_PORT=4000

# --- Backend / FastAPI ---
APP_SECRET_KEY=CHANGE_ME

# --- CORS (env-driven, comma-separated; never use wildcard with credentials) ---
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# --- AWS region (no AWS credentials in Phase 0; used from Phase 1) ---
AWS_DEFAULT_REGION=us-east-1

# --- Phase 4: AI Cost Analyst (LiteLLM Gateway) ---
# Master switch. Phase 4 ships disabled by default so no AI provider
# is contacted during development. Set to "true" only AFTER a real
# model alias and credentials are configured in LiteLLM.
AI_ENABLED=false
# Base URL for the LiteLLM gateway. Defaults to the internal Docker
# service name. Do NOT point this at a public provider endpoint.
LITELLM_BASE_URL=http://litellm:4000
# Logical model alias registered in LiteLLM (e.g. cost-detective-free).
# No provider or model name should appear in backend code.
LITELLM_MODEL=cost-detective-free
# API key for the LiteLLM gateway. Leave empty when AI_ENABLED=false.
LITELLM_API_KEY=
# Bounded cost controls for Phase 4.
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_CONTEXT_RECOMMENDATIONS=20
AI_MAX_CONTEXT_SERVICES=15
AI_MAX_CONTEXT_REGIONS=10
AI_MAX_QUESTION_LENGTH=2000

# --- Phase 5A: Application Authentication + RBAC ---
# Master switch. When false (the Phase 0-4 default), business APIs
# remain anonymous so existing development flows are unaffected.
# When true, every business route requires a valid bearer token.
# Do NOT flip this to true until a real, unique JWT_SECRET has
# been provisioned; the application refuses to start otherwise.
AUTH_ENABLED=false
# Symmetric HMAC key used to sign access tokens (HS256 by default).
# Required when AUTH_ENABLED=true: must be at least 32 characters
# and MUST NOT be a documented placeholder.  Generate with:
#   openssl rand -hex 32
# In production, store this in your secret manager and inject it
# at runtime.  NEVER commit a real secret to source control.
JWT_SECRET=CHANGE_ME_REPLACE_WITH_RANDOM_32_PLUS_CHAR_SECRET
# JWT signing algorithm.  HS256 is the Phase 5A default; the field
# is configurable so a future OIDC integration can switch to
# asymmetric algorithms without code changes.
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes.  Phase 5A ships stateless
# access tokens only; refresh tokens are deferred.  Keep this
# short enough that an inactive token does not survive forever,
# long enough that interactive clients do not have to re-login
# during normal use.  60 minutes is a reasonable starting point.
JWT_ACCESS_TOKEN_MINUTES=60
# JWT issuer / audience are checked on every verify call so tokens
# from another service cannot be replayed against this API.
JWT_ISSUER=ai-cloud-cost-detective
JWT_AUDIENCE=ai-cloud-cost-detective-api
